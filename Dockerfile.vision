FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    YOLO_CONFIG_DIR=/models/config

RUN apt-get update \
    && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
# Use CPU wheels so this optional demo does not require an NVIDIA GPU.
RUN python -m pip install torch torchvision --index-url https://download.pytorch.org/whl/cpu
COPY requirements-vision-docker.txt .
RUN python -m pip install --no-cache-dir -r requirements-vision-docker.txt
COPY vision.py .
RUN mkdir -p /models /media

CMD ["python", "vision.py", "--source", "/media/factory_demo.mp4", "--api", "http://backend:8000", "--model", "/models/yolo11n.pt", "--headless", "--loop"]
